# Copia este archivo a .env y rellena los valores. .env no se sube a git.
POSTGRES_USER=ufc
POSTGRES_PASSWORD=ufc
POSTGRES_DB=ufc
# Desde tu máquina (fuera de Docker) la base de datos está en localhost:5432
DATABASE_URL=postgresql+psycopg://ufc:ufc@localhost:5432/ufc

# Fases siguientes
ODDS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Puntuación de fuentes (docs/04-fuentes.md)
SOURCE_MIN_PREDICTIONS=20
SOURCE_HALF_LIFE_DAYS=365
